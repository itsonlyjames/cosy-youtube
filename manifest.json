{
  "manifest_version": 3,
  "name": "Cosy YouTube",
  "version": "1.0.1",
  "description": "Enjoy an incredibly cosy lo-fi experience with Cosy YouTube",

  "permissions": ["storage"],

  "host_permissions": ["*://*.youtube.com/*"],

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Cosy YouTube Toggle",
    "default_icon": {
      "16": "icons/extension_icon@16px.png",
      "32": "icons/extension_icon@32px.png",
      "48": "icons/extension_icon@48px.png",
      "128": "icons/extension_icon@128px.png"
    }
  },

  "icons": {
    "16": "icons/extension_icon@16px.png",
    "32": "icons/extension_icon@32px.png",
    "48": "icons/extension_icon@48px.png",
    "128": "icons/extension_icon@128px.png"
  },

  "background": {
    "service_worker": "background.js"
  }
}
